--// ============================================
--// 3. CONFIGURAÇÃO (peça: roblox-petsystem + AlignPosition)
--// ============================================
local Config = {
    Enabled       = true,
    Mode          = "Player",      -- "Player" | "Model"
    ModelName     = "MyPet",       -- usado se Mode = "Model"
    PrimaryPart   = nil,           -- auto-detecta se nil

    -- Follow (peça: Quantum)
    BaseSpeed     = 25,
    MinSpeed      = 8,
    MaxSpeed      = 90,
    Responsiveness = 0.15,         -- 0.05 = mais rápido, 0.3 = mais suave (AlignPosition)
    LookAtTarget  = true,

    -- Offset (peça: roblox-petsystem)
    OffsetType    = "Behind",
    OffsetDistance = 8,
    OffsetHeight  = 4,

    FollowRange   = 150,
}

--// ============================================
--// 4. HELPERS DE OFFSET (roblox-petsystem)
--// ============================================
local function getOffsetPosition(rootCF)
    local look  = rootCF.LookVector
    local right = rootCF.RightVector
    local up    = Vector3.new(0, 1, 0)
    local p     = rootCF.Position
    local t, d, h = Config.OffsetType, Config.OffsetDistance, Config.OffsetHeight

    if     t == "Behind"   then p = p - look  * d + up * h
    elseif t == "Front"    then p = p + look  * d + up * h
    elseif t == "Above"    then p = p + up    * d
    elseif t == "Below"    then p = p - up    * d
    elseif t == "Left"     then p = p - right * d + up * h
    elseif t == "Right"    then p = p + right * d + up * h
    elseif t == "Diagonal" then p = p - look * d + right * (d * 0.6) + up * h
    end
    return p
end

--// ============================================
--// 5. ALVO MAIS PRÓXIMO
--// ============================================
local function getNearestTargetCF(fromPos)
    local bestCF, bestDist = nil, Config.FollowRange
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and hum and hum.Health > 0 then
            local dist = (root.Position - fromPos).Magnitude
            if dist < bestDist then
                bestDist, bestCF = dist, root.CFrame
            end
        end
    end
    return bestCF
end

--// ============================================
--// 6. OBTER O "FOLLOWER" (Player ou Model)
--// ============================================
local function getFollowerPart()
    if Config.Mode == "Model" then
        local model = workspace:FindFirstChild(Config.ModelName, true)
        if not model or not model:IsA("Model") then return nil end
        local part = Config.PrimaryPart and model:FindFirstChild(Config.PrimaryPart)
                     or model.PrimaryPart
        if not part then return nil end
        return part
    else
        local char = Players.LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end
end

--// ============================================
--// 7. LOOP PRINCIPAL (peça: Quantum Follow + AlignPosition)
--//    Usa CFrame:Lerp em vez de recriar Tween → estável
--// ============================================
RunService.Heartbeat:Connect(function(dt)
    if not Config.Enabled then return end

    local follower = getFollowerPart()
    if not follower then return end

    local targetCF = getNearestTargetCF(follower.Position)
    if not targetCF then return end

    local targetPos = getOffsetPosition(targetCF)

    -- CFrame de destino (com ou sem LookAt)
    local goalCF
    if Config.LookAtTarget then
        goalCF = CFrame.lookAt(targetPos, targetCF.Position)
    else
        goalCF = CFrame.new(targetPos) * (follower.CFrame - follower.CFrame.Position)
    end

    -- Fator de suavidade (peça: AlignPosition Responsiveness)
    -- alpha = 1 - (1 - responsiveness)^(dt * 60) → igual em qualquer FPS
    local alpha = 1 - (1 - Config.Responsiveness) ^ (dt * 60)

    -- Interpolação suave (peça: Quantum Follow)
    follower.CFrame = follower.CFrame:Lerp(goalCF, alpha)
end)

